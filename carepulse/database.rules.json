{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null && auth.uid === $uid"
        },
        "devices": {
          ".read": "auth != null && auth.uid === $uid"
        },
        "measurements": {
          ".read": "auth != null && auth.uid === $uid",
          "$requestId": {
            ".write": "auth != null && auth.uid === $uid && newData.exists()",
            ".validate": "$requestId.matches(/^[0-9A-F]{8}$/) && newData.hasChildren(['requestId', 'deviceId', 'bpm', 'spo2', 'activity', 'note', 'scanDuration', 'timestamp'])",
            "requestId": { ".validate": "newData.isString() && newData.val() === $requestId" },
            "deviceId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9:_-]{1,128}$/)" },
            "bpm": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 250" },
            "spo2": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100" },
            "activity": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "scanDuration": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 20" },
            "timestamp": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1577836800000 && newData.val() <= now + 300000" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
