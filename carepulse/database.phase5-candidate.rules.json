{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null && auth.uid === $uid"
        },
        "devices": {
          ".read": "auth != null && auth.uid === $uid"
        },
        "measurements": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
